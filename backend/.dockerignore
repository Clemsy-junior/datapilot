# Keep the build context small and reproducible: anything that is generated,
# machine-specific or secret must never enter an image layer.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
tests/
.env
.env.*
!.env.example
.git/
.gitignore
Dockerfile
.dockerignore
