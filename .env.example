# ---------------------------------------------------------------------------
# DataPilot — exemple de configuration.
# Copier en `.env` à la racine : `cp .env.example .env`
# Aucune valeur secrète réelle ne doit être committée dans ce fichier.
# ---------------------------------------------------------------------------

# --- Fournisseur LLM -------------------------------------------------------

# "fake"      : fournisseur scripté, déterministe, aucune clé requise.
#               C'est le défaut : le projet démarre et se démontre hors ligne.
# "anthropic" : Anthropic Messages API (tool use). Nécessite ANTHROPIC_API_KEY.
DATAPILOT_LLM_PROVIDER=fake

# Clé API Anthropic. Laisser vide tant que DATAPILOT_LLM_PROVIDER=fake.
# Ne jamais committer de clé réelle.
DATAPILOT_ANTHROPIC_API_KEY=

# Modèle utilisé par le fournisseur anthropic.
DATAPILOT_ANTHROPIC_MODEL=claude-sonnet-4-5

# Base URL de l'API Anthropic (surchargeable pour un proxy ou un mock).
DATAPILOT_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Nombre maximal de tokens générés par appel LLM.
DATAPILOT_LLM_MAX_TOKENS=2048

# --- Garde-fous de la boucle agentique -------------------------------------

# Nombre maximal d'allers-retours LLM <-> outils pour un message utilisateur.
# Au-delà, la boucle s'arrête proprement et l'explique à l'utilisateur.
DATAPILOT_MAX_ITERATIONS=8

# Timeout global, en secondes, pour le traitement d'un message utilisateur.
DATAPILOT_REQUEST_TIMEOUT_SECONDS=60

# Nombre maximal de lignes de données qu'un outil renvoie au LLM.
# Au-delà, le résultat est tronqué et marqué `truncated: true`.
DATAPILOT_MAX_TOOL_ROWS=50

# --- Datasets --------------------------------------------------------------

# Répertoire contenant les CSV. `sales.csv` y est committé pour une démo immédiate.
DATAPILOT_DATA_DIR=data

# Taille maximale d'un CSV uploadé, en mégaoctets.
DATAPILOT_MAX_UPLOAD_MB=25

# --- HTTP ------------------------------------------------------------------

# Origines autorisées par CORS, séparées par des virgules.
# En production derrière nginx, le front et l'API partagent l'origine :
# CORS n'est alors pas sollicité et cette liste peut rester vide.
DATAPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (lu par Vite au build) ---------------------------------------

# Base de l'API vue par le navigateur.
# Vide = même origine (cas nginx). En dev, Vite proxifie /api vers le backend.
VITE_API_BASE=
